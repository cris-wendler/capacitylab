# CapacityLab configuration. Copy to `.env` and adjust. Never commit `.env`.
# Every value below is a placeholder; the mock demo runs with no credentials at all.

# Stakeholder turn provider: "mock" (deterministic, offline, labeled MOCK) or "anthropic" (real model, spends money)
CAPACITYLAB_PROVIDER=mock

# Needed only when CAPACITYLAB_PROVIDER=anthropic. Leave empty for the demo and for tests.
ANTHROPIC_API_KEY=
# Only for API keys not scoped to a workspace: the workspace to bill (Console > Settings > Workspaces).
ANTHROPIC_WORKSPACE_ID=
CAPACITYLAB_MODEL=claude-opus-5
# Reasoning effort: "auto" uses a per-role value (roles that quote measurements run low; roles weighing
# tradeoffs get more room). Set low, medium or high to apply one value to every role.
CAPACITYLAB_EFFORT=auto
CAPACITYLAB_MAX_OUTPUT_TOKENS=5000
# Refusal fallback (server-side) for the real provider. Set to false to disable.
CAPACITYLAB_REFUSAL_FALLBACK=true

# Spend guard. Per-token prices are configuration, not truth: verify them against current provider pricing.
CAPACITYLAB_INPUT_USD_PER_MTOK=5.00
CAPACITYLAB_OUTPUT_USD_PER_MTOK=25.00
# Per run, and in total across all runs (tracked in <runs dir>/spend-ledger.json).
CAPACITYLAB_MAX_USD_PER_RUN=2.00
CAPACITYLAB_MAX_USD_TOTAL=3.00
CAPACITYLAB_MAX_ROUNDS=3
CAPACITYLAB_MAX_TOOL_CALLS=40

# Experiment sandbox and lab: "sqlite" (in-process) or "mysql" (local Docker container only; see docker-compose.yml).
# The MySQL sandbox refuses any host other than localhost and any database not prefixed "capacitylab_sandbox".
CAPACITYLAB_SANDBOX=sqlite
CAPACITYLAB_MYSQL_HOST=127.0.0.1
CAPACITYLAB_MYSQL_PORT=3307
CAPACITYLAB_MYSQL_USER=root
CAPACITYLAB_MYSQL_PASSWORD=change-me-local-only
CAPACITYLAB_MYSQL_DATABASE=capacitylab_sandbox

# Percona Toolkit for `capacitylab lab run --percona`. Tools run from this image inside the lab container's network
# namespace; only containers named "capacitylab-*" are accepted.
CAPACITYLAB_PERCONA_IMAGE=percona/percona-toolkit:latest
CAPACITYLAB_LAB_CONTAINER=capacitylab-sandbox-mysql

# Where run ledgers, lab evidence, and the spend ledger are written.
CAPACITYLAB_RUNS_DIR=runs
